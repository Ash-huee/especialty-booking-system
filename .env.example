# Example configuration. Copy to `.env` for local development:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# Never commit a real `.env` file containing secrets.

APP_NAME=Especialty
APP_ENV=development
DEBUG=True

# Supabase connection (Phase 1). Server-side only.
# Get these from the Supabase dashboard (Project Settings -> API).
# Never commit real values. Leave empty for local unit tests.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
